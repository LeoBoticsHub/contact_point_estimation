<?xml version="1.0"?>
<package format="3">
  <name>contact_point_estimation</name>
  <version>0.1.0</version>
  <description>
    Contact point and surface normal estimation from force-torque measurements using adaptive control.
  </description>
  <license>BSD</license>

  <url type="website">http://wiki.ros.org/contact_point_estimation</url>

  <maintainer email="giuseppe.alfonso@leonardo.com">Giuseppe Alfonso</maintainer>
  <author email="giuseppe.alfonso@leonardo.com">Giuseppe Alfonso</author>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build dependencies -->
  <build_depend>rclcpp</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>std_srvs</build_depend>
  <build_depend>ament_cmake_eigen</build_depend>
  <build_depend>eigen_utils</build_depend>
  <build_depend>boost</build_depend>

  <!-- Run dependencies -->
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ament_cmake_eigen</exec_depend>
  <exec_depend>eigen_utils</exec_depend>
  <exec_depend>boost</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
